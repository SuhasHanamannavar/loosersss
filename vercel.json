{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/activate.ps1", "destination": "/api/script" },
    { "source": "/activate.ps1", "destination": "/api/script" },
    { "source": "/api/view.ps1", "destination": "/api/view-script" },
    { "source": "/view.ps1", "destination": "/api/view-script" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
